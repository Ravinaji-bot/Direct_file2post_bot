API_HASH=your_api_hash
DATABASE_URI=mongodb+srv://username:db-password@cluster.mongodb.net/
LOG_CHANNEL=-1001234567890
ADMINS=123456789

# Recommended
CHANNELS=-1001234567890
BIN_CHANNEL=-1001234567890
